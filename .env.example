# ZTFA — root .env.example
# Copy to .env and fill in values; .env is gitignored.

# --- Federation ---
N_CLIENTS=3
ROUND_PERIOD_SEC=600
PER_CLIENT_FEE_WEI=500000000000000     # 0.0005 ETH
AGGREGATOR_PAYMENT_WEI=1000000000000000 # 0.001 ETH

# --- Chain ---
CHAIN_RPC_URL=http://localhost:8545
CHAIN_ID=31337
# Anvil deterministic mnemonic accounts:
#   account[0] = aggregator service wallet
#   account[1..3] = client wallets (one per client)
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
AGGREGATOR_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# --- Infra ---
DATABASE_URL=postgresql://ztfa:ztfa_dev@localhost:5432/ztfa
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ztfa
S3_SECRET_KEY=ztfa_dev_minio
S3_CIPHERTEXT_BUCKET=ciphertexts
S3_AGGREGATE_BUCKET=aggregates
MQTT_HOST=localhost
MQTT_PORT=1883

# --- Contracts (filled by bootstrap.sh after deploy) ---
FEDERATION_ROUND_ADDRESS=
VERIFIER_ADDRESS=

# --- Crypto paths ---
KEYS_DIR=./keys
CIRCUIT_BUILD_DIR=./circuits/build

# --- Portal (only used by Next.js) ---
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://localhost:8545
NEXT_PUBLIC_FEDERATION_ROUND_ADDRESS=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=stub_for_local_dev
NEXT_PUBLIC_LOCAL_CLIENT_RPC_URL=http://localhost:7000
