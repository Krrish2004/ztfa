%% ZTFA — trust matrix (HLD §9.1 Figure 4)
graph TB
    subgraph CAN_DECRYPT[Can decrypt c_i / c_sum]
        SelfClient[Self Client<br/>own sk-share]
        OtherClients[T-of-N other clients<br/>via threshold]
    end
    subgraph CANNOT_DECRYPT[Cannot decrypt — only compute]
        Agg[Aggregator<br/>has pk only<br/>★ runtime guard enforced ★]
    end
    subgraph SEES_HASHES[Sees only hashes]
        Contract[Smart contract<br/>verifies SNARK]
        Validators[Chain validators<br/>order txs]
    end

    SelfClient -.->|raw weights<br/>raw IoT data| SelfClient
    OtherClients -.->|nothing private<br/>without T shares| OtherClients
    Agg -->|ciphertexts<br/>commitments| SEES_HASHES
    SEES_HASHES -->|public<br/>auditable| Validators

    classDef trusted fill:#1e3a5f,stroke:#6c8eff
    classDef untrusted fill:#5f1e1e,stroke:#ff6c6c
    classDef ledger fill:#1e5f3a,stroke:#6cff8e
    class CAN_DECRYPT trusted
    class CANNOT_DECRYPT untrusted
    class SEES_HASHES ledger
